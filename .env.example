# Compliance Copilot — backend environment.
# Copy to .env (root of repo) and fill in real values. .env is git-ignored.

# ── Postgres (Supabase or local) ─────────────────────────────────────────
# For Supabase: host = db.<project-ref>.supabase.co, sslmode = require
# For local (docker-compose): host = localhost, sslmode = prefer
PG_HOST=localhost
PG_PORT=5432
PG_DB=postgres
PG_USER=postgres
PG_PASSWORD=changeme
PG_SSLMODE=prefer

# ── Supabase storage + reports table (only needed for the upload pipeline) ─
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Ollama (local LLM, OpenAI-compatible API) ────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=qwen2:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated extra origins (localhost:3000 is always allowed)
CORS_ALLOW_ORIGINS=
